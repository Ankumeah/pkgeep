FROM golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder

WORKDIR /opt/build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
  go build -o ./pkgeep -ldflags='-s -w' .

FROM archlinux@sha256:52dfbd5afb23a220d5ee92dafcb4c788d96c026ed04179890c23adef4c897fa0

WORKDIR /root/

COPY FOR_TERRA/setup/ .
COPY FOR_TERRA/specifics/archlinux-config.yaml config.yaml
COPY FOR_TERRA/specifics/archlinux-setup.sh setup.sh
COPY specs/ ./specs
RUN chmod +x start.sh
RUN chmod +x setup.sh

COPY --from=builder /opt/build/pkgeep .

ENTRYPOINT [ "/root/start.sh" ]
