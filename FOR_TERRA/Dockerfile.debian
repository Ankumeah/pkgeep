FROM golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder

WORKDIR /opt/build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
  go build -o ./pkgeep -ldflags='-s -w' .

FROM debian@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5

WORKDIR /root/

COPY FOR_TERRA/common/ .
COPY FOR_TERRA/specifics/debian-config.yaml config.yaml
COPY FOR_TERRA/specifics/debian-setup.sh setup.sh
COPY specs/ ./specs
RUN chmod +x start.sh
RUN chmod +x setup.sh

COPY --from=builder /opt/build/pkgeep .

ENTRYPOINT [ "/root/start.sh" ]
