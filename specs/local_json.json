{
  "type": "object",
  "required": [
    "name",
    "type",
    "enabled",
    "config"
  ],
  "properties": {
    "name": {
      "const": "local_json",
      "description": "Name of the package manager or storage"
    },
    "type": {
      "const": "storage",
      "description": "package_manager or storage"
    },
    "enabled": {
      "type": "boolean",
      "description": "Weather or not use to this entry"
    },
    "config": {
      "type": "object",
      "description": "Entry specifc values",
      "required": [
        "save_path"
      ],
      "properties": {
        "save_path": {
          "type": "string",
          "description": "Path to the file to store the packages in"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
