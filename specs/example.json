[
  {
    "name": "pacman",
    "type": "package_manager",
    "enabled": false,
    "config": {
      "config_file": "/path/to/config/file",
      "cmd": "/path/to/pkgeep/binary",
      "su": "sudo",
      "timeout_seconds": 60.0
    }
  },
  {
    "name": "apt",
    "type": "package_manager",
    "enabled": false,
    "config": {
      "config_file": "/path/to/config/file",
      "cmd": "/path/to/pkgeep/binary",
      "su": "sudo",
      "timeout_seconds": 60.0
    }
  },
  {
    "name": "dpkg",
    "type": "package_manager",
    "enabled": false,
    "config": {
      "config_file": "/path/to/config/file",
      "cmd": "/path/to/pkgeep/binary",
      "su": "sudo",
      "timeout_seconds": 60.0
    }
  },
  {
    "name": "local_json",
    "type": "storage",
    "enabled": true,
    "config": {
      "save_path": "/path/to/json",
      "timeout_seconds": 60.0
    }
  },
  {
    "name": "github_gist",
    "type": "storage",
    "enabled": false,
    "config": {
      "gist_id": "gist_id",
      "filename": "github_gist.json",
      "auth": "auth",
      "timeout_seconds": 60.0
    }
  },
  {
    "name": "s3",
    "type": "storage",
    "enabled": false,
    "config": {
      "object_id": "pkgeep.json",
      "bucket": "pkgeep",
      "location": "us-east-1",
      "url": "url",
      "access_key_id": "access_key_id",
      "secret_access_key": "secret_access_key",
      "ssl": true,
      "timeout_seconds": 60.0
    }
  }
]
